[Desktop Entry]
Type=Application
Name=AppImage Launcher & Runner
GenericName=AppImage Runner
Comment=Automatically integrate, update shortcuts, and execute AppImages
Exec=appimage-run %F
Icon=application-x-executable
Terminal=false
StartupNotify=true
MimeType=application/vnd.appimage;application/x-iso9660-appimage;application/x-appimage;
Categories=Utility;System;
NoDisplay=true

#!/usr/bin/env bash
# appimage-watch — Watch Applications & Downloads for AppImages and auto-integrate them.
#
# Designed to run in the background (systemd user service or Hyprland exec-once).

set -euo pipefail

INTEGRATE_CMD="${HOME}/.local/bin/appimage-integrate"
log()  { printf '\e[36m[appimage-watch]\e[0m %s\n' "$*"; }
warn() { printf '\e[33m[appimage-watch] WARNING:\e[0m %s\n' "$*" >&2; }

WATCH_DIRS=()
for d in "${1:-${HOME}/Applications}" "${HOME}/Downloads" "${HOME}/.t3"; do
    if [[ -d "$d" ]]; then
        WATCH_DIRS+=("$d")
    fi
done

[[ ${#WATCH_DIRS[@]} -gt 0 ]] || {
    mkdir -p "${HOME}/Applications"
    WATCH_DIRS=("${HOME}/Applications")
}

[[ -x "$INTEGRATE_CMD" ]] || { warn "appimage-integrate not found at $INTEGRATE_CMD"; exit 1; }

# Initial scan & cleanup
log "Initial scan of: ${WATCH_DIRS[*]} ..."
"$INTEGRATE_CMD" --scan
"$INTEGRATE_CMD" --clean

# If inotifywait is available, use real-time watching
if command -v inotifywait >/dev/null 2>&1; then
    log "Watching ${WATCH_DIRS[*]} in real time via inotify..."
    inotifywait -m -r -e close_write,moved_to,create "${WATCH_DIRS[@]}" --format '%w%f' 2>/dev/null \
    | while IFS= read -r filepath; do
        case "${filepath,,}" in
            *.appimage)
                if [[ -f "$filepath" ]]; then
                    log "AppImage event detected: $filepath"
                    sleep 1
                    "$INTEGRATE_CMD" "$filepath" || warn "Failed to integrate: $filepath"
                    "$INTEGRATE_CMD" --clean || true
                fi
                ;;
        esac
    done
else
    # Fallback polling loop
    warn "inotifywait not found — using 60s periodic polling scan."
    while true; do
        sleep 60
        "$INTEGRATE_CMD" --scan >/dev/null 2>&1 || true
    done
fi
